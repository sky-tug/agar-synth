# --- data and outputs (large, reproducible) ---
data/
runs/
# NOTE: runs/ is out, but THE RESULTS INSIDE IT ARE NOT.
# run_metrics.json and eval*/summary.json are a few KB each and are NOT
# REPRODUCIBLE (500+ GPU-hours). `python scripts/collect.py` gathers them under
# results/, and results/ DOES go into git.
# Run collect.py after a batch of runs (decision 3.33).
wandb/
*.pt
*.zip

# --- Phase 3 generation intermediates (26 August) ---
# These were NOT meant to be in git but were not in .gitignore either, so they
# were quietly committed during the demo period (~700 PNGs under crops_100,
# safetensors under lora_100). On the full data there would be four levels x
# thousands of crops; closed off before the repository bloats.
# They were removed from history entirely when the repo was made public (3.95).
src/generate/crops_*/
src/generate/lora_*/*.safetensors
src/generate/lora_*/*.bin
# BUT the small, NON-REPRODUCIBLE ones DO go into git:
#   layout_<level>.json    fitted layout distribution      (a few KB)
#   bg_pool_<level>.json   background pool selection       (a few KB)
#   lora_*/adapter_config.json + adapt_metrics.json + README.md
# These are the paper's reproducibility record and must not be deleted.

# --- virtual environments -- must NEVER enter git (several GB) ---
.venv/
src/.venv/
venv/
env/
.conda/

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- scratch ---
# (out.txt and reports_ozet.txt were dropped on 11 September: no code writes
#  them any more, the patterns matched nothing.)
*.log
.DS_Store

# Model weights live NOWHERE in this repository (1 September).
# The earlier rule was src/generate/lora_*/*.safetensors and covered only one
# level; intermediate checkpoints under lora_*/step_*/ slipped through.
*.safetensors

# --- Phase 4 pilot intermediates (1 September) ---
# All reproducible from layout_<level>.json + bg_pool_<level>.json +
# lora_<level>/. Full-size images do not enter git.
src/generate/plans_*/
src/generate/build_*/
src/generate/synth_*/

# --- internal working documents: removed from git history (11 September) ---
# They contained personal working notes. Copies are kept outside the repository.
PROJE_DURUMU.md
FAZ4_BASLANGIC.md
